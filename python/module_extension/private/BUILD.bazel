load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":cc_extension.bzl", "py_cc_extension_libs")

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//python/module_extension:__pkg__"],
    deps = [
        "//python:defs_bzl",
        "@bazel_skylib//lib:paths",
        "@rules_cc//cc:core_rules",
    ],
)

py_cc_extension_libs(
    name = "current_py_cc_libs",
    libs = "@rules_python//python/cc:current_py_cc_libs",
    visibility = ["//visibility:public"],
)
