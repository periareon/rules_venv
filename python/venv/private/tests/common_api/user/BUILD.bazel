load("//python/venv:defs.bzl", "py_binary", "py_library")
load("//python/venv/private/tests/common_api:actions_test.bzl", "aspect_user_test")

py_library(
    name = "user",
    srcs = ["user.py"],
    deps = ["//python/venv/private/tests/common_api/user_dep"],
)

aspect_user_test(
    name = "lib_user",
    target = ":user",
    test = "user_test.py",
)

py_binary(
    name = "user_bin",
    srcs = ["user.py"],
    main = "user.py",
    deps = ["//python/venv/private/tests/common_api/user_dep"],
)

aspect_user_test(
    name = "bin_user",
    target = ":user_bin",
    test = "user_test.py",
)
