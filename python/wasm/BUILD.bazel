load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "py_wasm_toolchain.bzl",
])

toolchain_type(
    name = "toolchain_type",
)

# Which build of CPython the default toolchains embed; see `CPYTHON_WASI` in
# `private/versions.bzl` for the variants and the default of each version.
# `--@rules_venv//python/wasm:cpython_variant=stock` picks CPython's own build,
# the fastest under wasmtime; `default` is the fastest under Bazel's runtime.
string_flag(
    name = "cpython_variant",
    build_setting_default = "default",
    values = [
        "default",
        "small-eval",
        "stock",
        "trampoline",
    ],
)

config_setting(
    name = "cpython_variant_default",
    flag_values = {":cpython_variant": "default"},
)

config_setting(
    name = "cpython_variant_small_eval",
    flag_values = {":cpython_variant": "small-eval"},
)

config_setting(
    name = "cpython_variant_stock",
    flag_values = {":cpython_variant": "stock"},
)

config_setting(
    name = "cpython_variant_trampoline",
    flag_values = {":cpython_variant": "trampoline"},
)

bzl_library(
    name = "py_wasm_toolchain_bzl",
    srcs = ["py_wasm_toolchain.bzl"],
    visibility = ["//python/wasm:__subpackages__"],
    deps = ["@bazel_skylib//lib:paths"],
)

bzl_library(
    name = "bzl_lib",
    srcs = [
        "defs.bzl",
        "extensions.bzl",
    ],
    # `extensions.bzl` also loads `@rules_python//python:versions.bzl`, whose
    # `bzl_library` rules_python keeps private.
    deps = [
        ":py_wasm_toolchain_bzl",
        "//python/wasm/private:bzl_lib",
        "@bazel_tools//tools:bzl_srcs",
    ],
)
