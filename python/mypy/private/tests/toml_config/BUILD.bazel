load("//python:defs.bzl", "py_library")
load("//python/mypy:defs.bzl", "py_mypy_test")

package(default_testonly = 1)

py_library(
    name = "lenient",
    srcs = ["lenient.py"],
    # The source is written to be something the workspace's own config
    # rejects, which is what makes the test below evidence that the TOML
    # config was the one that was read. The aspect has no say in which
    # config it runs under, so it is kept off this target.
    tags = ["no_mypy"],
)

py_mypy_test(
    name = "lenient_mypy_test",
    config = "mypy_config.toml",
    target = ":lenient",
)
